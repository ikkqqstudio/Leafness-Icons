[Icon Theme]
Name=Leafness
Comment=Fancy icon core set (falls back to Oxygen Or Breeze If Missing Or Not Possible)
Inherits=oxygen,breeze,hicolor
Example=folder
DisplayDepth=32
Directories=scalable/apps,scalable/devices,scalable/mimetypes,scalable/places,scalable/status,scalable/actions,scalable/applets
FollowsColorScheme=true


[scalable/apps]
Size=64
MinSize=16
MaxSize=512
Type=Scalable
Context=Applications

[scalable/devices]
Size=64
MinSize=16
MaxSize=512
Type=Scalable
Context=Devices

[scalable/mimetypes]
Size=64
MinSize=16
MaxSize=512
Type=Scalable
Context=MimeTypes

[scalable/places]
Size=64
MinSize=16
MaxSize=512
Type=Scalable
Context=Places

[scalable/status]
Size=64
MinSize=16
MaxSize=512
Type=Scalable
Context=Places

[scalable/applets]
Size=16
MinSize=1
MaxSize=16
Type=Scalable
Context=Applications

[scalable/actions]
Size=64
MinSize=1
MaxSize=512
Type=Scalable
Context=Actions
